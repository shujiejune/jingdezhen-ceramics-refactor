# =============================================================================
# Jingdezhen Ceramics backend — example environment.
# Copy to .env and fill in real values. .env is gitignored (never commit it).
# Sandbox/live is a per-adapter flip; leave secrets empty for local dev and
# adapters fall back to no-op/mock behaviour (TDD §4.1, §10).
# =============================================================================

# --- Server ---
SERVER_PORT=8080
CLIENT_ORIGIN=http://localhost:5173   # SolidStart dev origin (to be created)
ADMIN_EMAIL=admin@example.com

# --- Database (PostgreSQL) ---
# Local (go run against containerized PG):
#   postgres://postgres:postgres@localhost:5432/jingdezhen_ceramics_db?sslmode=disable
# Inside Compose the api service overrides this to reach the `db` host.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jingdezhen_ceramics_db?sslmode=disable
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jingdezhen_ceramics_db
DB_PORT=5432
DB_SSLMODE=disable

# --- Redis (sessions, cache, Asynq queues, pub/sub) ---
# Local (go run against containerized Redis):
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Consent HMAC key (GDPR) ---
# Seeds the HMAC that hashes visitor IPs in consent_records. Rotate in prod.
# Any long random string; leave the .env default for local dev.
CONSENT_HMAC_KEY=change-me-to-a-long-random-string

# --- 2FA TOTP-secret encryption key (TDD §5.3) ---
# AES-GCM key for encrypting TOTP secrets at rest. A DB dump alone cannot
# recover secrets without this key. Any long random string; rotate carefully
# (rotation requires re-encrypting all stored secrets).
TWO_FA_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

# --- Brevo (transactional email) — replaces AWS SES (TDD §10) ---
# Empty API key => no-op sender that logs emails locally.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Jingdezhen Ceramics

# --- Airwallex (card payments; settles to CNY) — sandbox until onboarding ---
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_ENV=sandbox
AIRWALLEX_WEBHOOK_SECRET=

# --- PayPal (alternative payment) — sandbox until onboarding ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# --- Qwen (LLM for the ceramic-art assistant chat) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- Alibaba Cloud OSS (HK) — object storage + image processing (TDD §2.1) ---
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=cn-hongkong

# --- FX pipeline (TDD §7, PRD §3.2.3) ---
# ECB daily rates feed. Empty => dev uses fixture rates (no network call).
# Live: https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
ECB_API_URL=
# FX markup in basis points (200 = 2%). Customer-facing presentment prices
# include this spread to cover FX volatility.
FX_MARKUP_BPS=200

# --- Payments (TDD §4.1) ----------------------------------------------------
# mock (dev default): checkout enqueues payment:finalize{success} to drive
#   created→paid without a real gateway. "live" requires the Airwallex/PayPal
#   adapters (#6) + sandbox creds; until then live mode returns an error so no
#   order is left dangling in `created`.
PAYMENTS_MODE=mock
