# =============================================================================
# Jingdezhen Ceramics backend — example environment.
# Copy to .env and fill in real values. .env is gitignored (never commit it).
# Sandbox/live is a per-adapter flip; leave secrets empty for local dev and
# adapters fall back to no-op/mock behaviour (TDD §4.1, §10).
# =============================================================================

# --- Server ---
SERVER_PORT=8080
CLIENT_ORIGIN=http://localhost:3000   # TanStack Start dev origin (frontend/)
SITE_BASE_URL=http://localhost:3000   # canonical public site origin for SEO (sitemap <loc>, robots Sitemap:) — the SolidStart SSR site (TDD §2.2)
ADMIN_EMAIL=admin@example.com

# --- Database (PostgreSQL) ---
# Local (go run against containerized PG):
#   postgres://postgres:postgres@localhost:5432/jingdezhen_ceramics_db?sslmode=disable
# Inside Compose the api service overrides this to reach the `db` host.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jingdezhen_ceramics_db?sslmode=disable
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jingdezhen_ceramics_db
DB_PORT=5432
DB_SSLMODE=disable

# --- Redis (sessions, cache, Asynq queues, pub/sub) ---
# Local (go run against containerized Redis):
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Consent HMAC key (GDPR) ---
# Seeds the HMAC that hashes visitor IPs in consent_records. Rotate in prod.
# Any long random string; leave the .env default for local dev.
CONSENT_HMAC_KEY=change-me-to-a-long-random-string

# --- 2FA TOTP-secret encryption key (TDD §5.3) ---
# AES-GCM key for encrypting TOTP secrets at rest. A DB dump alone cannot
# recover secrets without this key. Any long random string; rotate carefully
# (rotation requires re-encrypting all stored secrets).
TWO_FA_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

# --- Brevo (transactional email) — replaces AWS SES (TDD §10) ---
# Empty API key => no-op sender that logs emails locally.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Jingdezhen Ceramics

# --- Airwallex (card payments; settles to CNY) — sandbox until onboarding ---
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_ENV=sandbox
AIRWALLEX_WEBHOOK_SECRET=

# --- PayPal (alternative payment) — sandbox until onboarding ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# --- Qwen (LLM for the ceramic-art assistant chat) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- Alibaba Cloud OSS (HK) — object storage + image processing (TDD §2.1) ---
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=cn-hongkong

# --- Object-storage adapter (TDD §4.1/§2.1) ---
# STORAGE_MODE=local (dev): LocalStore writes to STORAGE_LOCAL_DIR, served via
#   a Fiber static mount at STORAGE_PUBLIC_BASE_URL. "oss": live Alibaba Cloud
#   OSS presign + CDN (not live-tested until creds land).
STORAGE_MODE=local
STORAGE_LOCAL_DIR=./_media
STORAGE_PUBLIC_BASE_URL=/media
# CDN domain override for OSS reads (empty = bucket URL). Set post-MVP.
OSS_PUBLIC_BASE_URL=

# --- PDF adapter (TDD §12: chromedp HTML→PDF) ---
# PDF_MODE=local (dev default): NoopGenerator — the worker skips storage +
#   pdf_key stays NULL (GET /certificates/:code/pdf 404s). No sidecar needed.
#   "chromedp": connect to a headless-shell sidecar at CHROMEDP_URL (the compose
#   `chromedp` service) over the DevTools remote protocol. The Go binary never
#   bundles Chromium.
PDF_MODE=local
CHROMEDP_URL=ws://chromedp:9222
# Origin the sidecar fetches <img> assets from (the QR) at render time. Inside
# compose: http://api:<port>. Empty => http://localhost:1323 (dev host).
PDF_BASE_URL=http://api:1323

# --- FX pipeline (TDD §7, PRD §3.2.3) ---
# ECB daily rates feed. Empty => dev uses fixture rates (no network call).
# Live: https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
ECB_API_URL=
# FX markup in basis points (200 = 2%). Customer-facing presentment prices
# include this spread to cover FX volatility.
FX_MARKUP_BPS=200

# --- Payments (TDD §4.1) ----------------------------------------------------
# mock (dev default): checkout enqueues payment:finalize{success} to drive
#   created→paid without a real gateway. "live" requires the Airwallex/PayPal
#   adapters (#6) + sandbox creds; until then live mode returns an error so no
#   order is left dangling in `created`.
PAYMENTS_MODE=mock

# --- In-house analytics (PRD §3.4.2, TDD §3.4/§4.2) ---
# ANALYTICS_HMAC_KEY seeds the daily-rotating visitor_hash key. Separate from
#   CONSENT_HMAC_KEY so a consent-db leak cannot forge analytics identities.
ANALYTICS_HMAC_KEY=change-me-to-a-different-long-random-string
# GEOIP_MODE=noop (dev default): every IP resolves to country 'ZZ' (no .mmdb
#   needed to run the app or tests). "maxmind": read a local GeoLite2-Country
#   db at GEOLITE2_DB_PATH (MaxMind account required to download the free db;
#   unknown/private IP → 'ZZ').
GEOIP_MODE=noop
# GEOLITE2_DB_PATH=./GeoLite2-Country.mmdb
