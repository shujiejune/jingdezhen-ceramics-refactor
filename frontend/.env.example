# mock = in-process typed mocks (default; offline dev)
# live = the sibling Go+Fiber API (../backend, `make up`, port 1323)
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:1323
# optional override for the browser-side API base in live mode
# (defaults: dev → VITE_API_BASE_URL via CORS, prod → same-origin /api)
# VITE_API_BROWSER_BASE=http://localhost:1323

# Deploy (staging/prod):
# Public site URL (no trailing slash). Used for canonical URLs, OG tags.
# SITE_BASE_URL=https://jdz-atelier.example
# Allowed CORS origin for the backend (comma-separated).
# CLIENT_ORIGIN=https://jdz-atelier.example

